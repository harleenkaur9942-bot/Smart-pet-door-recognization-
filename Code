23 void setup() {

24 Serial.begin(115200);

25 Serial.setDebugOutput(true);

26 Serial.println();

27

28 camera_config_t config;

29 config.ledc_channel = LEDC_CHANNEL_0;

30 config.ledc_timer = LEDC_TIMER_0;

31 config.pin_d0 = Y2_GPIO_NUM;

32 config.pin_d1 = Y3_GPIO_NUM;

33 config.pin_d2 = Y4_GPIO_NUM;

34 config.pin_d3 = Y5_GPIO_NUM;

35 config.pin_d4 = Y6_GPIO_NUM;

36 config.pin_d5 = Y7_GPIO_NUM;

37 config.pin_d6 = Y8_GPIO_NUM;

38 config.pin_d7 = Y9_GPIO_NUM;

39 config.pin_xclk = XCLK_GPIO_NUM;

40 config.pin_pclk = PCLK_GPIO_NUM;

41 config.pin_vsync = VSYNC_GPIO_NUM;

42 config.pin_href = HREF_GPIO_NUM;

43 config.pin_sccb_sda = SIOD_GPIO_NUM;

44 config.pin_sccb_scl = SIOC_GPIO_NUM;

45 config.pin_pwdn = PWDN_GPIO_NUM;

46 config.pin_reset = RESET_GPIO_NUM;

47 config.xclk_freq_hz = 20000000;

48 config.frame_size = FRAMESIZE_UXGA;

49 config.pixel_format = PIXFORMAT_JPEG; // for streaming

50 //config.pixel_format = PIXFORMAT_RGB565; // for face detection/recognition

51 config.grab_mode = CAMERA_GRAB_WHEN_EMPTY;

52 config.fb_location = CAMERA_FB_IN_PSRAM;

53 config.jpeg_quality = 12;

54 config.fb_count = 1;

55

56 // if PSRAM IC present, init with UXGA resolution and higher JPEG quality 62 config.grab_mode = CAMERA_GRAB_LATEST;

63 } else {

64 // Limit the frame size when PSRAM is not available

65 config.frame_size = FRAMESIZE_SVGA;

66 config.fb_location = CAMERA_FB_IN_DRAM;

67 }

68 } else {

69 // Best option for face detection/recognition

70 config.frame_size = FRAMESIZE_240X240;

71 #if CONFIG_IDF_TARGET_ESP32S3

72 config.fb_count = 2;

73 #endif

74 }

75

76 #if defined(CAMERA_MODEL_ESP_EYE)

77 pinMode(13, INPUT_PULLUP);

78 pinMode(14, INPUT_PULLUP);

79 #endif

80

81 // camera init

82 esp_err_t err = esp_camera_init(&config);

83 if (err != ESP_OK) {

84 Serial.printf("Camera init failed with error 0x%x", err);

85 return;

86 }

87

88 sensor_t *s = esp_camera_sensor_get();

89 // initial sensors are flipped vertically and colors are a bit saturated

90 if (s->id.PID == OV3660_PID) {

91 s->set_vflip(s, 1); // flip it back

92 s->set_brightness(s, 1); // up the brightness just a bit

93 s->set_saturation(s, -2); // lower the saturation

94 }

95 // drop down frame size for higher initial frame rate

96 if (config.pixel_format == PIXFORMAT_JPEG) {

97 s->set_framesize(s, FRAMESIZE_QVGA);

98 }

99

100 #if defined(CAMERA_MODEL_M5STACK_WIDE) || defined(CAMERA_MODEL_M5STACK_ESP32CAM)

101 s->set_vflip(s, 1);

102 s->set_hmirror(s, 1);

103 #endif

104

105 #if defined(CAMERA_MODEL_ESP32S3_EYE)

106 s->set_vflip(s, 1);

107 #endif

108

109 // Setup LED FLash if LED pin is defined in camera_pins.h

110 #if defined(LED_GPIO_NUM)

111 setupLedFlash();

112 #endif

113

114 WiFi.begin(ssid, password);

115 WiFi.setSleep(false);

116

117 Serial.print("WiFi connecting");

118 while (WiFi.status() != WL_CONNECTED) {

119 delay(500);

120 Serial.print(".");

121 }

122 Serial.println("");

123 Serial.println("WiFi connected"); 124

125 startCameraServer();

126

127 Serial.print("Camera Ready! Use 'http://");

128 Serial.print(WiFi.localIP());

129 Serial.println("' to connect");

130 }

